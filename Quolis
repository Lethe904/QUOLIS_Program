{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOVk/YkVR47iN0A7BJPN7eS"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["<!DOCTYPE html>\n","<html lang=\"ja\">\n","<head>\n","    <meta charset=\"UTF-8\">\n","    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n","    <title>QUOLIS PROGRAM | PISRA Security Research Agency</title>\n","    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n","    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n","    <link href=\"https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Share+Tech+Mono&family=Noto+Sans+JP:wght@400;700&display=swap\" rel=\"stylesheet\">\n","    <style>\n","        :root {\n","            --bg-void: #000000;\n","            --bg-surface: #070709;\n","            --bg-elevated: #0e0e12;\n","            --border-dim: #26262e;\n","            --border-mid: #4e4e5a;\n","            --border-bright: #ffffff;\n","            --text-primary: #ffffff;\n","            --text-secondary: #a0a0ac;\n","            --text-muted: #585864;\n","\n","            /* Rank Theme Colors (D -> S) */\n","            --rank-d: #4caf50; /* Green */\n","            --rank-c: #ffee58; /* Yellow */\n","            --rank-b: #ffa726; /* Orange */\n","            --rank-a: #ef5350; /* Red */\n","            --rank-s: #26c6da; /* Cyan */\n","        }\n","\n","        * {\n","            box-sizing: border-box;\n","            margin: 0;\n","            padding: 0;\n","            user-select: none;\n","            -webkit-user-select: none;\n","            -webkit-tap-highlight-color: transparent;\n","        }\n","\n","        body {\n","            background-color: #020203;\n","            color: var(--text-primary);\n","            font-family: 'Chakra Petch', 'Noto Sans JP', sans-serif;\n","            display: flex;\n","            justify-content: center;\n","            align-items: center;\n","            min-height: 100vh;\n","            overflow: hidden;\n","            font-variant-numeric: tabular-nums;\n","        }\n","\n","        .mono {\n","            font-family: 'Share Tech Mono', monospace;\n","        }\n","\n","        /* Android Portrait Viewport Frame */\n","        .terminal-shell {\n","            width: 100%;\n","            max-width: 480px;\n","            height: 100vh;\n","            height: 100dvh;\n","            background-color: var(--bg-void);\n","            border-left: 1px solid var(--border-dim);\n","            border-right: 1px solid var(--border-dim);\n","            display: flex;\n","            flex-direction: column;\n","            position: relative;\n","            overflow: hidden;\n","            box-shadow: 0 0 60px rgba(255, 255, 255, 0.05);\n","        }\n","\n","        /* Subtle Tactical Scanlines */\n","        .terminal-shell::after {\n","            content: \"\";\n","            position: absolute;\n","            inset: 0;\n","            background: repeating-linear-gradient(\n","                0deg,\n","                rgba(255, 255, 255, 0.015) 0px,\n","                rgba(255, 255, 255, 0.015) 1px,\n","                transparent 1px,\n","                transparent 3px\n","            );\n","            pointer-events: none;\n","            z-index: 900;\n","        }\n","\n","        /* Corner Bracket HUD Frame */\n","        .hud-frame {\n","            position: relative;\n","            border: 1px solid var(--border-dim);\n","            background: var(--bg-surface);\n","        }\n","        .hud-frame::before,\n","        .hud-frame::after {\n","            content: \"\";\n","            position: absolute;\n","            width: 8px;\n","            height: 8px;\n","            border-color: var(--border-bright);\n","            border-style: solid;\n","            pointer-events: none;\n","        }\n","        .hud-frame::before {\n","            top: -1px;\n","            left: -1px;\n","            border-width: 1px 0 0 1px;\n","        }\n","        .hud-frame::after {\n","            bottom: -1px;\n","            right: -1px;\n","            border-width: 0 1px 1px 0;\n","        }\n","\n","        .screen {\n","            display: none;\n","            flex-direction: column;\n","            height: 100%;\n","            width: 100%;\n","        }\n","        .screen.active {\n","            display: flex;\n","        }\n","\n","        /* =========================================================\n","           1. AUTHENTICATION & INITIAL SETUP SCREEN\n","        ========================================================= */\n","        #auth-screen {\n","            justify-content: space-between;\n","            padding: 18px 16px 22px 16px;\n","            background: radial-gradient(circle at 50% 22%, #0c0d11 0%, #000000 76%);\n","        }\n","\n","        .auth-top-meta {\n","            display: flex;\n","            justify-content: space-between;\n","            font-size: 0.62rem;\n","            color: var(--text-muted);\n","            letter-spacing: 1px;\n","            border-bottom: 1px solid var(--border-dim);\n","            padding-bottom: 6px;\n","        }\n","\n","        .auth-title-block {\n","            text-align: center;\n","            padding: 12px 10px;\n","            border-top: 1px solid var(--border-bright);\n","            border-bottom: 1px solid var(--border-bright);\n","            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.035), transparent);\n","            margin-top: 8px;\n","        }\n","\n","        .auth-agency-mini {\n","            font-size: 0.56rem;\n","            color: var(--text-muted);\n","            letter-spacing: 1.5px;\n","            margin-bottom: 3px;\n","        }\n","\n","        .auth-project {\n","            font-size: 0.72rem;\n","            letter-spacing: 3px;\n","            color: var(--text-secondary);\n","            margin-bottom: 2px;\n","        }\n","\n","        .auth-program {\n","            font-size: 1.7rem;\n","            font-weight: 700;\n","            letter-spacing: 4px;\n","            line-height: 1.1;\n","            text-shadow: 0 0 14px rgba(255, 255, 255, 0.25);\n","        }\n","\n","        .auth-clearance-tag {\n","            display: inline-block;\n","            margin-top: 8px;\n","            padding: 3px 10px;\n","            border: 1px solid var(--border-bright);\n","            background: #ffffff;\n","            color: #000000;\n","            font-size: 0.64rem;\n","            font-weight: 700;\n","            letter-spacing: 2px;\n","        }\n","\n","        .auth-clearance-tag.setup-mode {\n","            background: #000000;\n","            color: var(--rank-s);\n","            border-color: var(--rank-s);\n","        }\n","\n","        /* 12-Digit Passcode Slots (_ _ _ _ - _ _ _ _ - _ _ _ _) */\n","        .passcode-box {\n","            margin: 8px 0;\n","            text-align: center;\n","        }\n","\n","        .passcode-prompt {\n","            font-size: 0.68rem;\n","            color: var(--text-primary);\n","            letter-spacing: 1.5px;\n","            margin-bottom: 4px;\n","            font-weight: 700;\n","        }\n","\n","        .passcode-subprompt {\n","            font-size: 0.6rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 1px;\n","            margin-bottom: 10px;\n","            min-height: 14px;\n","        }\n","\n","        .slots-container {\n","            display: flex;\n","            align-items: center;\n","            justify-content: center;\n","            gap: 4px;\n","            padding: 10px 6px;\n","            border: 1px solid var(--border-dim);\n","            background: #040406;\n","        }\n","\n","        .slot-group {\n","            display: flex;\n","            gap: 3px;\n","        }\n","\n","        .slot-dash {\n","            color: var(--text-muted);\n","            font-size: 0.9rem;\n","            padding: 0 1px;\n","        }\n","\n","        .code-slot {\n","            width: 21px;\n","            height: 32px;\n","            border: 1px solid var(--border-dim);\n","            background: #0a0a0d;\n","            display: flex;\n","            align-items: center;\n","            justify-content: center;\n","            font-size: 1.05rem;\n","            color: var(--text-primary);\n","            transition: all 0.1s ease;\n","        }\n","\n","        .code-slot.filled {\n","            border-color: var(--border-bright);\n","            background: #16161c;\n","            box-shadow: 0 0 6px rgba(255, 255, 255, 0.25);\n","        }\n","\n","        .code-slot.cursor {\n","            border-color: var(--text-secondary);\n","            animation: blinkCursor 1s infinite;\n","        }\n","\n","        @keyframes blinkCursor {\n","            0%, 100% { border-color: #ffffff; }\n","            50% { border-color: #33333d; }\n","        }\n","\n","        .digit-counter {\n","            margin-top: 6px;\n","            font-size: 0.62rem;\n","            color: var(--text-muted);\n","            letter-spacing: 1.5px;\n","        }\n","\n","        /* Keypad */\n","        .keypad-area {\n","            width: 100%;\n","            max-width: 340px;\n","            margin: 0 auto;\n","        }\n","\n","        .keypad-grid {\n","            display: grid;\n","            grid-template-columns: repeat(3, 1fr);\n","            gap: 8px;\n","            margin-bottom: 10px;\n","        }\n","\n","        .pad-btn {\n","            background: var(--bg-surface);\n","            border: 1px solid var(--border-mid);\n","            color: var(--text-primary);\n","            font-family: 'Share Tech Mono', monospace;\n","            font-size: 1.45rem;\n","            padding: 11px 0;\n","            cursor: pointer;\n","            transition: background 0.08s, transform 0.05s;\n","        }\n","\n","        .pad-btn:active {\n","            background: #ffffff;\n","            color: #000000;\n","            transform: scale(0.97);\n","        }\n","\n","        .pad-btn.fn-btn {\n","            font-size: 0.78rem;\n","            letter-spacing: 1px;\n","            color: var(--text-secondary);\n","            border-color: var(--border-dim);\n","        }\n","\n","        .submit-login-btn {\n","            width: 100%;\n","            background: #ffffff;\n","            color: #000000;\n","            border: 1px solid #ffffff;\n","            font-family: 'Chakra Petch', sans-serif;\n","            font-size: 0.9rem;\n","            font-weight: 700;\n","            letter-spacing: 3px;\n","            padding: 13px 0;\n","            cursor: pointer;\n","            transition: opacity 0.15s;\n","        }\n","\n","        .submit-login-btn:active {\n","            opacity: 0.8;\n","        }\n","\n","        /* Credential Approved Transition Overlay */\n","        #credential-overlay {\n","            position: absolute;\n","            inset: 0;\n","            background: #000000;\n","            z-index: 500;\n","            display: none;\n","            flex-direction: column;\n","            justify-content: center;\n","            align-items: center;\n","            padding: 24px;\n","            text-align: center;\n","        }\n","\n","        .credential-box {\n","            width: 100%;\n","            max-width: 340px;\n","            border: 1px solid #ffffff;\n","            padding: 28px 20px;\n","            background: #060608;\n","        }\n","\n","        .credential-status {\n","            font-size: 1.15rem;\n","            font-weight: 700;\n","            letter-spacing: 3px;\n","            margin-bottom: 14px;\n","        }\n","\n","        .loader-bar-outer {\n","            width: 100%;\n","            height: 6px;\n","            border: 1px solid #ffffff;\n","            padding: 1px;\n","            margin-bottom: 10px;\n","        }\n","\n","        .loader-bar-inner {\n","            height: 100%;\n","            width: 0%;\n","            background: #ffffff;\n","            transition: width 0.65s cubic-bezier(0.22, 1, 0.36, 1);\n","        }\n","\n","        .loading-subtext {\n","            font-size: 0.72rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 2px;\n","        }\n","\n","        /* =========================================================\n","           2. MAIN DASHBOARD HEADER & USER DOSSIER\n","        ========================================================= */\n","        .top-header {\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","            padding: 9px 14px;\n","            border-bottom: 1px solid var(--border-bright);\n","            background: #050507;\n","        }\n","\n","        .header-brand {\n","            display: flex;\n","            flex-direction: column;\n","        }\n","\n","        .header-title {\n","            font-size: 1.05rem;\n","            font-weight: 700;\n","            letter-spacing: 2.5px;\n","            line-height: 1.1;\n","        }\n","\n","        .header-sub {\n","            font-size: 0.58rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 1.5px;\n","        }\n","\n","        .logout-btn {\n","            display: flex;\n","            align-items: center;\n","            gap: 5px;\n","            background: transparent;\n","            border: 1px solid var(--border-mid);\n","            color: var(--text-primary);\n","            padding: 6px 9px;\n","            font-family: 'Chakra Petch', sans-serif;\n","            font-size: 0.65rem;\n","            font-weight: 700;\n","            letter-spacing: 1.5px;\n","            cursor: pointer;\n","        }\n","\n","        .logout-btn:active {\n","            background: #ffffff;\n","            color: #000000;\n","        }\n","\n","        /* User Clearance Dossier Strip */\n","        .dossier-strip {\n","            padding: 8px 14px;\n","            background: #09090c;\n","            border-bottom: 1px solid var(--border-dim);\n","            font-size: 0.65rem;\n","        }\n","\n","        .dossier-agency-row {\n","            display: flex;\n","            justify-content: space-between;\n","            color: var(--text-secondary);\n","            font-size: 0.56rem;\n","            letter-spacing: 0.4px;\n","            padding-bottom: 4px;\n","            margin-bottom: 5px;\n","            border-bottom: 1px dashed var(--border-dim);\n","        }\n","\n","        .dossier-agent-row {\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","        }\n","\n","        .agent-identity {\n","            display: flex;\n","            align-items: center;\n","            gap: 8px;\n","        }\n","\n","        .agent-avatar-box {\n","            width: 26px;\n","            height: 26px;\n","            border: 1px solid var(--border-mid);\n","            display: flex;\n","            align-items: center;\n","            justify-content: center;\n","            background: #000000;\n","            color: #ffffff;\n","        }\n","\n","        .agent-meta-col {\n","            display: flex;\n","            flex-direction: column;\n","        }\n","\n","        .agent-name-txt {\n","            font-weight: 700;\n","            font-size: 0.78rem;\n","            letter-spacing: 1px;\n","            color: #ffffff;\n","            line-height: 1.1;\n","        }\n","\n","        .agent-affil-txt {\n","            color: var(--text-secondary);\n","            font-size: 0.64rem;\n","        }\n","\n","        .agent-serial-col {\n","            text-align: right;\n","            display: flex;\n","            flex-direction: column;\n","            gap: 2px;\n","        }\n","\n","        .agent-code-tag {\n","            font-size: 0.58rem;\n","            color: var(--text-secondary);\n","            border: 1px solid var(--border-dim);\n","            padding: 1px 5px;\n","        }\n","\n","        .clearance-lvl-mini {\n","            font-size: 0.54rem;\n","            color: var(--text-muted);\n","            letter-spacing: 1px;\n","        }\n","\n","        /* Scrollable Viewport */\n","        .content-viewport {\n","            flex: 1;\n","            overflow-y: auto;\n","            padding: 12px 14px;\n","        }\n","\n","        .tab-view {\n","            display: none;\n","            animation: fadeIn 0.15s ease-out;\n","        }\n","\n","        .tab-view.active {\n","            display: block;\n","        }\n","\n","        @keyframes fadeIn {\n","            from { opacity: 0.4; transform: translateY(3px); }\n","            to { opacity: 1; transform: translateY(0); }\n","        }\n","\n","        .section-bar {\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","            border-bottom: 1px solid var(--border-bright);\n","            padding-bottom: 5px;\n","            margin-bottom: 10px;\n","        }\n","\n","        .section-bar-title {\n","            font-size: 0.82rem;\n","            font-weight: 700;\n","            letter-spacing: 2px;\n","        }\n","\n","        .section-bar-meta {\n","            font-size: 0.64rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 1px;\n","        }\n","\n","        /* =========================================================\n","           3. HOME TAB (PRIVATE POINT -> RANK -> BASIC POINT -> CLAIM)\n","        ========================================================= */\n","        .hero-pp-card {\n","            padding: 14px;\n","            margin-bottom: 10px;\n","            border: 1px solid var(--border-bright);\n","            background: linear-gradient(135deg, #0b0b0e 0%, #050507 100%);\n","        }\n","\n","        .point-card-top {\n","            display: flex;\n","            justify-content: space-between;\n","            font-size: 0.64rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 1.5px;\n","            margin-bottom: 4px;\n","        }\n","\n","        .hero-pp-display {\n","            display: flex;\n","            align-items: baseline;\n","            justify-content: flex-end;\n","            gap: 8px;\n","        }\n","\n","        .hero-pp-digits {\n","            font-size: 2.55rem;\n","            font-weight: 700;\n","            line-height: 1;\n","            letter-spacing: 1px;\n","            text-shadow: 0 0 12px rgba(255, 255, 255, 0.2);\n","        }\n","\n","        .hero-pp-unit {\n","            font-size: 0.95rem;\n","            font-weight: 700;\n","            color: var(--text-secondary);\n","            letter-spacing: 1px;\n","        }\n","\n","        /* Current Rank Panel */\n","        .rank-panel {\n","            padding: 13px 14px;\n","            margin-bottom: 10px;\n","            border-width: 1px;\n","            transition: border-color 0.3s;\n","        }\n","\n","        .rank-top-row {\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","        }\n","\n","        .rank-badge-block {\n","            display: flex;\n","            align-items: center;\n","            gap: 12px;\n","        }\n","\n","        .rank-emblem {\n","            width: 58px;\n","            height: 58px;\n","            border: 2px solid currentColor;\n","            display: flex;\n","            align-items: center;\n","            justify-content: center;\n","            font-size: 2.6rem;\n","            font-weight: 700;\n","            line-height: 1;\n","            background: rgba(255, 255, 255, 0.02);\n","        }\n","\n","        .rank-meta-stack {\n","            display: flex;\n","            flex-direction: column;\n","            gap: 2px;\n","        }\n","\n","        .rank-label-sm {\n","            font-size: 0.6rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 2px;\n","        }\n","\n","        .rank-tier-name {\n","            font-size: 0.98rem;\n","            font-weight: 700;\n","            letter-spacing: 1.5px;\n","        }\n","\n","        .conversion-pill {\n","            text-align: right;\n","            border: 1px solid var(--border-dim);\n","            background: #040405;\n","            padding: 5px 9px;\n","        }\n","\n","        .conversion-lbl {\n","            font-size: 0.54rem;\n","            color: var(--text-secondary);\n","            letter-spacing: 1px;\n","        }\n","\n","        .conversion-val {\n","            font-size: 1.2rem;\n","            font-weight: 700;\n","        }\n","\n","        .promotion-area {\n","            margin-top: 11px;\n","            padding-top: 9px;\n","            border-top: 1px dashed var(--border-dim);\n","        }\n","\n","        .promo-header {\n","            display: flex;\n","            justify-content: space-between;\n","            font-size: 0.66rem;\n","            letter-spacing: 1px;\n","            margin-bottom: 5px;\n","        }\n","\n","        .promo-bar-bg {\n","            width: 100%;\n","            height: 6px;\n","            background: #111115;\n","            border: 1px solid var(--border-dim);\n","            overflow: hidden;\n","        }\n","\n","        .promo-bar-fill {\n","            height: 100%;\n","            width: 0%;\n","            transition: width 0.35s ease, background-color 0.3s ease;\n","        }\n","\n","        /* Rank Theme Utility Classes */\n","        .c-rank-d { color: var(--rank-d); border-color: var(--rank-d); }\n","        .c-rank-c { color: var(--rank-c); border-color: var(--rank-c); }\n","        .c-rank-b { color: var(--rank-b); border-color: var(--rank-b); }\n","        .c-rank-a { color: var(--rank-a); border-color: var(--rank-a); }\n","        .c-rank-s { color: var(--rank-s); border-color: var(--rank-s); }\n","\n","        /* Basic Point Card */\n","        .bp-card {\n","            padding: 11px 14px;\n","            margin-bottom: 10px;\n","        }\n","\n","        .bp-value-display {\n","            display: flex;\n","            align-items: baseline;\n","            justify-content: flex-end;\n","            gap: 8px;\n","        }\n","\n","        .bp-digits {\n","            font-size: 1.9rem;\n","            font-weight: 700;\n","            line-height: 1;\n","            letter-spacing: 1px;\n","        }\n","\n","        .bp-unit {\n","            font-size: 0.82rem;\n","            font-weight: 700;\n","            color: var(--text-secondary);\n","        }\n","\n","        /* 0900 JST Private Point Claim Card */\n","        .allowance-card {\n","            padding: 12px 14px;\n","            border: 1px solid var(--border-mid);\n","            background: #08080b;\n","        }\n","\n","        .allowance-top {\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","            margin-bottom: 6px;\n","        }\n","\n","        .allowance-title {\n","            display: flex;\n","            align-items: center;\n","            gap: 6px;\n","            font-size: 0.7rem;\n","            font-weight: 700;\n","            letter-spacing: 1px;\n","        }\n","\n","        .allowance-grant-badge {\n","            font-size: 0.74rem;\n","            font-weight: 700;\n","            padding: 2px 7px;\n","            border: 1px solid var(--border-bright);\n","            background: #121216;\n","        }\n","\n","        .allowance-status-line {\n","            display: flex;\n","            justify-content: space-between;\n","            font-size: 0.6rem;\n","            color: var(--text-secondary);\n","            margin-bottom: 9px;\n","        }\n","\n","        .claim-execute-btn {\n","            width: 100%;\n","            background: #ffffff;\n","            color: #000000;\n","            border: 1px solid #ffffff;\n","            padding: 11px;\n","            font-family: 'Chakra Petch', sans-serif;\n","            font-size: 0.8rem;\n","            font-weight: 700;\n","            letter-spacing: 2px;\n","            cursor: pointer;\n","        }\n","\n","        .claim-execute-btn:disabled {\n","            background: #121216;\n","            color: var(--text-muted);\n","            border-color: var(--border-dim);\n","            cursor: not-allowed;\n","        }\n","\n","        /* =========================================================\n","           4. ACTION & REWARD CARDS\n","        ========================================================= */\n","        .action-card {\n","            border: 1px solid var(--border-dim);\n","            background: var(--bg-surface);\n","            padding: 12px;\n","            margin-bottom: 9px;\n","            display: flex;\n","            justify-content: space-between;\n","            align-items: center;\n","            gap: 10px;\n","            transition: border-color 0.15s;\n","        }\n","\n","        .action-card:hover {\n","            border-color: var(--border-mid);\n","        }\n","\n","        .action-info {\n","            flex: 1;\n","            min-width: 0;\n","        }\n","\n","        .action-name {\n","            font-size: 0.88rem;\n","            font-weight: 700;\n","            margin-bottom: 5px;\n","            word-break: break-word;\n","        }\n","\n","        .action-tags {\n","            display: flex;\n","            flex-wrap: wrap;\n","            gap: 6px;\n","            font-size: 0.68rem;\n","        }\n","\n","        .tag-pill {\n","            padding: 2px 6px;\n","            border: 1px solid var(--border-dim);\n","            background: #0c0c10;\n","        }\n","\n","        .tag-pos {\n","            border-color: rgba(76, 175, 80, 0.5);\n","            color: var(--rank-d);\n","        }\n","\n","        .tag-neg {\n","            border-color: rgba(239, 83, 80, 0.5);\n","            color: var(--rank-a);\n","        }\n","\n","        .tag-cost {\n","            border-color: var(--border-mid);\n","            color: #ffffff;\n","        }\n","\n","        .trigger-btn {\n","            background: transparent;\n","            border: 1px solid var(--border-bright);\n","            color: var(--text-primary);\n","            padding: 9px 12px;\n","            font-family: 'Chakra Petch', sans-serif;\n","            font-size: 0.7rem;\n","            font-weight: 700;\n","            letter-spacing: 1.5px;\n","            cursor: pointer;\n","            white-space: nowrap;\n","        }\n","\n","        .trigger-btn:active {\n","            background: #ffffff;\n","            color: #000000;\n","        }\n","\n","        .trigger-btn.neg-btn {\n","            border-color: var(--rank-a);\n","            color: var(--rank-a);\n","        }\n","\n","        .trigger-btn.neg-btn:active {\n","            background: var(--rank-a);\n","            color: #000000;\n","        }\n","\n","        .trigger-btn:disabled {\n","            border-color: var(--border-dim);\n","            color: var(--text-muted);\n","            cursor: not-allowed;\n","        }\n","\n","        /* =========================================================\n","           5. ADMINISTRATION TAB\n","        ========================================================= */\n","        .admin-panel-card {\n","            border: 1px solid var(--border-dim);\n","            background: var(--bg-surface);\n","            padding: 12px;\n","            margin-bottom: 14px;\n","        }\n","\n","        .admin-card-hd {\n","            font-size: 0.72rem;\n","            font-weight: 700;