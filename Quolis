ss=\"cyber-btn\" onclick=\"createProtocolItem('reward')\">+ REGISTER REWARD</button>\n","                    <div class=\"admin-item-list\" id=\"admin-reward-list\"></div>\n","                </div>\n","\n","                <!-- System Reset -->\n","                <div class=\"admin-panel-card hud-frame\">\n","                    <div class=\"admin-card-hd\" style=\"color:var(--rank-a);\">SYSTEM INITIALIZATION</div>\n","                    <button class=\"cyber-btn danger\" id=\"factory-reset-btn\" onclick=\"openResetModal()\">RESET ALL SYSTEM DATA</button>\n","                </div>\n","\n","                <!-- Cloud Sync & Manual Node Backup -->\n","                <div class=\"admin-panel-card hud-frame\">\n","                    <div class=\"admin-card-hd\" style=\"display:flex; justify-content:space-between; align-items:center;\">\n","                        <span>CLOUD SYNCHRONIZATION & NODE BACKUP</span>\n","                        <span id=\"sync-status-badge\" class=\"mono\" style=\"font-size:0.62rem; color:var(--rank-d);\">SYNC: INITIALIZING</span>\n","                    </div>\n","                    <div style=\"font-size:0.64rem; color:var(--text-secondary); margin-bottom:8px; line-height:1.4;\">\n","                        SAME 12-DIGIT PASSCODE AUTO-LINKS ACROSS TERMINALS. USE BACKUP KEY FOR OFFLINE TRANSFER.\n","                    </div>\n","                    <div class=\"field-group\">\n","                        <input type=\"text\" id=\"backup-code-io\" class=\"cyber-input mono\" placeholder=\"ENCRYPTED NODE DATA STRING\">\n","                    </div>\n","                    <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:8px;\">\n","                        <button class=\"cyber-btn ghost\" onclick=\"exportNodeBackup()\">EXPORT DATA KEY</button>\n","                        <button class=\"cyber-btn ghost\" onclick=\"importNodeBackup()\">IMPORT DATA KEY</button>\n","                    </div>\n","                </div>\n","            </section>\n","\n","        </main>\n","\n","        <!-- Bottom Navigation Bar (5 Tabs with Icons) -->\n","        <nav class=\"bottom-nav\">\n","            <div class=\"nav-item active\" data-target=\"home\" onclick=\"switchTab('home')\">\n","                <svg viewBox=\"0 0 24 24\">\n","                    <path d=\"M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5z\"></path>\n","                </svg>\n","                <span>HOME</span>\n","            </div>\n","            <div class=\"nav-item\" data-target=\"positive\" onclick=\"switchTab('positive')\">\n","                <svg viewBox=\"0 0 24 24\">\n","                    <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line>\n","                    <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n","                </svg>\n","                <span>POSITIVE</span>\n","            </div>\n","            <div class=\"nav-item\" data-target=\"negative\" onclick=\"switchTab('negative')\">\n","                <svg viewBox=\"0 0 24 24\">\n","                    <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n","                </svg>\n","                <span>NEGATIVE</span>\n","            </div>\n","            <div class=\"nav-item\" data-target=\"reward\" onclick=\"switchTab('reward')\">\n","                <svg viewBox=\"0 0 24 24\">\n","                    <polygon points=\"12 2 22 12 12 22 2 12 12 2\"></polygon>\n","                </svg>\n","                <span>REWARD</span>\n","            </div>\n","            <div class=\"nav-item\" data-target=\"admin\" onclick=\"switchTab('admin')\">\n","                <svg viewBox=\"0 0 24 24\">\n","                    <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n","                    <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.604.852.997 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"></path>\n","                </svg>\n","                <span>ADMIN</span>\n","            </div>\n","        </nav>\n","    </div>\n","</div>\n","\n","<script type=\"module\">\n","    import { initializeApp } from \"https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js\";\n","    import { getAuth, signInAnonymously, signInWithCustomToken } from \"https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js\";\n","    import { getFirestore, doc, getDoc, setDoc, deleteDoc, onSnapshot } from \"https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js\";\n","\n","    const STORAGE_KEY = \"quolis_program_terminal_v2\";\n","    const APP_ID = typeof __app_id !== \"undefined\" ? __app_id : \"quolis-program-default\";\n","\n","    let db = null;\n","    let auth = null;\n","    let currentUser = null;\n","    let activeSyncDocId = null;\n","    let unsubscribeSnapshot = null;\n","    let isCloudConnected = false;\n","\n","    function createDefaultState() {\n","        return {\n","            pinHash: null, // null on first launch -> triggers Initial 12-Digit Setup\n","            bp: 0,\n","            pp: 0,\n","            lastClaimCycleId: \"\",\n","            agentName: \"AMAMIYA Reika\",\n","            agentAffil: \"SITE-07 Director\",\n","            agentId: \"A01F-T006033\",\n","            updatedAt: 0,\n","            positiveActions: [\n","                { id: 101, name: \"早朝覚醒プロトコル遵守 (06:30前起床)\", pts: 50 },\n","                { id: 102, name: \"身体能力維持トレーニング (30分)\", pts: 100 },\n","                { id: 103, name: \"専門領域研究・高度学習 (1時間)\", pts: 150 },\n","                { id: 104, name: \"環境統制・居住区画の完全整理\", pts: 60 }\n","            ],\n","            negativeActions: [\n","                { id: 201, name: \"睡眠規律違反 (00:00以降就寝)\", pts: 50 },\n","                { id: 202, name: \"無目的メディア消費 (1時間超過)\", pts: 100 },\n","                { id: 203, name: \"指定タスク・スケジュール遅延\", pts: 150 }\n","            ],\n","            rewards: [\n","                { id: 301, name: \"嗜好飲料・特別配給品の摂取許可\", pts: 150 },\n","                { id: 302, name: \"娯楽映像コンテンツ視聴 (1作品)\", pts: 300 },\n","                { id: 303, name: \"完全自由行動時間枠の確保 (2時間)\", pts: 500 }\n","            ]\n","        };\n","    }\n","\n","    let state = createDefaultState();\n","\n","    // Auth & Initial Setup State\n","    let pinBuffer = \"\";\n","    let setupStep = 1; // 1 = enter new 12-digit passcode, 2 = confirm 12-digit passcode\n","    let firstSetupPin = \"\";\n","\n","    let editingTarget = null;\n","    let toastTimeout = null;\n","\n","    /* =========================================================\n","       FIREBASE CLOUD INITIALIZATION & REAL-TIME SYNC ENGINE\n","    ========================================================= */\n","    function updateSyncStatusBadge(text, colorVar) {\n","        const badge = document.getElementById(\"sync-status-badge\");\n","        if (badge) {\n","            badge.textContent = text;\n","            badge.style.color = colorVar;\n","        }\n","    }\n","\n","    async function initCloudEngine() {\n","        try {\n","            if (typeof __firebase_config === \"undefined\" || !__firebase_config) {\n","                updateSyncStatusBadge(\"SYNC: LOCAL STORAGE ONLY\", \"var(--rank-c)\");\n","                return;\n","            }\n","            const firebaseConfig = JSON.parse(__firebase_config);\n","            const app = initializeApp(firebaseConfig);\n","            auth = getAuth(app);\n","            db = getFirestore(app);\n","\n","            if (typeof __initial_auth_token !== \"undefined\" && __initial_auth_token) {\n","                const cred = await signInWithCustomToken(auth, __initial_auth_token);\n","                currentUser = cred.user;\n","            } else {\n","                const cred = await signInAnonymously(auth);\n","                currentUser = cred.user;\n","            }\n","\n","            isCloudConnected = Boolean(db && currentUser);\n","            if (isCloudConnected) {\n","                updateSyncStatusBadge(\"SYNC: CLOUD ONLINE\", \"var(--rank-d)\");\n","                if (state.pinHash) {\n","                    attachCloudListener(state.pinHash);\n","                }\n","            } else {\n","                updateSyncStatusBadge(\"SYNC: LOCAL CACHE\", \"var(--rank-c)\");\n","            }\n","        } catch (err) {\n","            console.warn(\"Cloud sync unavailable, operating with local persistence:\", err);\n","            isCloudConnected = false;\n","            updateSyncStatusBadge(\"SYNC: OFFLINE / LOCAL\", \"var(--rank-c)\");\n","        }\n","    }\n","\n","    function getCloudDocRef(pinHash) {\n","        return doc(db, \"artifacts\", APP_ID, \"public\", \"data\", \"quolis_nodes\", pinHash);\n","    }\n","\n","    function attachCloudListener(pinHash) {\n","        if (!isCloudConnected || !db || !currentUser || !pinHash) return;\n","        if (activeSyncDocId === pinHash && unsubscribeSnapshot) return;\n","\n","        if (unsubscribeSnapshot) {\n","            unsubscribeSnapshot();\n","            unsubscribeSnapshot = null;\n","        }\n","\n","        activeSyncDocId = pinHash;\n","        const ref = getCloudDocRef(pinHash);\n","\n","        unsubscribeSnapshot = onSnapshot(ref, (snap) => {\n","            if (!snap.exists()) return;\n","            const remoteData = snap.data();\n","            if (!remoteData || !remoteData.pinHash) return;\n","\n","            // Apply remote update if newer than local state\n","            if ((remoteData.updatedAt || 0) > (state.updatedAt || 0)) {\n","                state = { ...createDefaultState(), ...remoteData };\n","                persistLocalOnly();\n","                renderDashboard();\n","                updateSyncStatusBadge(\"SYNC: CLOUD LIVE\", \"var(--rank-s)\");\n","            }\n","        }, (err) => {\n","            console.error(\"Realtime listener error:\", err);\n","            updateSyncStatusBadge(\"SYNC: RETRYING...\", \"var(--rank-b)\");\n","        });\n","    }\n","\n","    async function fetchCloudNodeByPinHash(pinHash) {\n","        if (!isCloudConnected || !db || !currentUser || !pinHash) return null;\n","        try {\n","            const snap = await getDoc(getCloudDocRef(pinHash));\n","            if (snap.exists()) {\n","                return snap.data();\n","            }\n","        } catch (err) {\n","            console.warn(\"Cloud lookup failed:\", err);\n","        }\n","        return null;\n","    }\n","\n","    async function pushStateToCloud() {\n","        if (!isCloudConnected || !db || !currentUser || !state.pinHash) return;\n","        try {\n","            const payload = JSON.parse(JSON.stringify(state));\n","            await setDoc(getCloudDocRef(state.pinHash), payload);\n","            updateSyncStatusBadge(\"SYNC: CLOUD LIVE\", \"var(--rank-d)\");\n","        } catch (err) {\n","            console.warn(\"Cloud write deferred:\", err);\n","            updateSyncStatusBadge(\"SYNC: LOCAL SAVED\", \"var(--rank-c)\");\n","        }\n","    }\n","\n","    /* =========================================================\n","       STORAGE, CRYPTO & TOAST UTILITIES\n","    ========================================================= */\n","    function persistLocalOnly() {\n","        try {\n","            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n","        } catch (err) {\n","            console.error(\"Failed to save local state:\", err);\n","        }\n","    }\n","\n","    function loadTerminalState() {\n","        try {\n","            const raw = localStorage.getItem(STORAGE_KEY);\n","            if (raw) {\n","                const parsed = JSON.parse(raw);\n","                state = { ...createDefaultState(), ...parsed };\n","            }\n","        } catch (err) {\n","            console.error(\"Failed to load terminal state:\", err);\n","        }\n","    }\n","\n","    function saveTerminalState() {\n","        state.updatedAt = Date.now();\n","        persistLocalOnly();\n","        renderDashboard();\n","        pushStateToCloud();\n","        if (state.pinHash) {\n","            attachCloudListener(state.pinHash);\n","        }\n","    }\n","\n","    async function sha256Hex(text) {\n","        const msgBuffer = new TextEncoder().encode(text);\n","        const hashBuffer = await crypto.subtle.digest(\"SHA-256\", msgBuffer);\n","        const hashArray = Array.from(new Uint8Array(hashBuffer));\n","        return hashArray.map(b => b.toString(16).padStart(2, \"0\")).join(\"\");\n","    }\n","\n","    function showToast(message, isAlert = false) {\n","        const toast = document.getElementById(\"hud-toast\");\n","        toast.textContent = message;\n","        toast.style.borderColor = isAlert ? \"var(--rank-a)\" : \"#ffffff\";\n","        toast.style.color = isAlert ? \"var(--rank-a)\" : \"#ffffff\";\n","        toast.style.display = \"block\";\n","\n","        if (toastTimeout) clearTimeout(toastTimeout);\n","        toastTimeout = setTimeout(() => {\n","            toast.style.display = \"none\";\n","        }, 2600);\n","    }\n","\n","    /* =========================================================\n","       12-DIGIT PASSCODE AUTHENTICATION & MULTI-TERMINAL LINKING\n","    ========================================================= */\n","    function configureAuthScreenMode() {\n","        const badge = document.getElementById(\"auth-clearance-badge\");\n","        const mainPrompt = document.getElementById(\"auth-main-prompt\");\n","        const subPrompt = document.getElementById(\"auth-sub-prompt\");\n","        const submitBtn = document.getElementById(\"auth-submit-btn\");\n","\n","        pinBuffer = \"\";\n","        setupStep = 1;\n","        firstSetupPin = \"\";\n","\n","        if (!state.pinHash) {\n","            badge.textContent = \"INITIAL SECURITY SETUP\";\n","            badge.classList.add(\"setup-mode\");\n","            mainPrompt.textContent = \"ENTER 12-DIGIT PASSCODE\";\n","            subPrompt.textContent = \"NEW REGISTRATION OR EXISTING NODE SYNC\";\n","            submitBtn.textContent = \"PROCEED\";\n","        } else {\n","            badge.textContent = \"LEVEL 4 SECURITY CLEARANCE\";\n","            badge.classList.remove(\"setup-mode\");\n","            mainPrompt.textContent = \"INPUT 12-DIGIT ACCESS PASSCODE\";\n","            subPrompt.textContent = \"AUTHORIZED PERSONNEL ONLY\";\n","            submitBtn.textContent = \"SUBMIT LOGIN\";\n","        }\n","        renderPasscodeSlots();\n","    }\n","\n","    function renderPasscodeSlots() {\n","        const container = document.getElementById(\"passcode-slots\");\n","        let html = \"\";\n","        for (let g = 0; g < 3; g++) {\n","            if (g > 0) html += `<span class=\"slot-dash\">-</span>`;\n","            html += `<div class=\"slot-group\">`;\n","            for (let i = 0; i < 4; i++) {\n","                const idx = g * 4 + i;\n","                const filled = idx < pinBuffer.length;\n","                const isCursor = idx === pinBuffer.length;\n","                html += `<div class=\"code-slot ${filled ? \"filled\" : \"\"} ${isCursor ? \"cursor\" : \"\"}\">${filled ? \"•\" : \"_\"}</div>`;\n","            }\n","            html += `</div>`;\n","        }\n","        container.innerHTML = html;\n","        document.getElementById(\"digit-counter-label\").textContent = `${pinBuffer.length} / 12 DIGITS`;\n","    }\n","\n","    function inputDigit(digit) {\n","        if (pinBuffer.length >= 12) return;\n","        pinBuffer += digit;\n","        renderPasscodeSlots();\n","    }\n","\n","    function clearInput() {\n","        pinBuffer = \"\";\n","        renderPasscodeSlots();\n","    }\n","\n","    function backspaceInput() {\n","        pinBuffer = pinBuffer.slice(0, -1);\n","        renderPasscodeSlots();\n","    }\n","\n","    async function handleAuthSubmit() {\n","        if (pinBuffer.length !== 12) {\n","            showToast(\"ERROR: 12 DIGITS REQUIRED\", true);\n","            return;\n","        }\n","\n","        const candidateHash = await sha256Hex(pinBuffer);\n","\n","        // First-Boot on this terminal: Check if another terminal already registered this 12-digit code in Cloud!\n","        if (!state.pinHash) {\n","            if (setupStep === 1) {\n","                const existingCloudNode = await fetchCloudNodeByPinHash(candidateHash);\n","                if (existingCloudNode && existingCloudNode.pinHash === candidateHash) {\n","                    state = { ...createDefaultState(), ...existingCloudNode };\n","                    persistLocalOnly();\n","                    attachCloudListener(candidateHash);\n","                    triggerApprovedTransition(\"CLOUD NODE SYNCHRONIZED\");\n","                    return;\n","                }\n","\n","                firstSetupPin = pinBuffer;\n","                pinBuffer = \"\";\n","                setupStep = 2;\n","                document.getElementById(\"auth-main-prompt\").textContent = \"CONFIRM 12-DIGIT ACCESS PASSCODE\";\n","                document.getElementById(\"auth-sub-prompt\").textContent = \"STEP 2 / 2 : RE-ENTER TO REGISTER NEW NODE\";\n","                document.getElementById(\"auth-submit-btn\").textContent = \"REGISTER & LOGIN\";\n","                renderPasscodeSlots();\n","                return;\n","            } else {\n","                if (pinBuffer !== firstSetupPin) {\n","                    showToast(\"MISMATCH: PASSCODES DO NOT MATCH\", true);\n","                    configureAuthScreenMode();\n","                    return;\n","                }\n","                state.pinHash = candidateHash;\n","                saveTerminalState();\n","                triggerApprovedTransition(\"CREDENTIAL REGISTERED\");\n","                return;\n","            }\n","        }\n","\n","        // Standard Login Verification Flow (also pulls latest cloud data on login)\n","        if (candidateHash === state.pinHash) {\n","            const latestCloudNode = await fetchCloudNodeByPinHash(candidateHash);\n","            if (latestCloudNode && (latestCloudNode.updatedAt || 0) > (state.updatedAt || 0)) {\n","                state = { ...createDefaultState(), ...latestCloudNode };\n","                persistLocalOnly();\n","            } else {\n","                pushStateToCloud();\n","            }\n","            attachCloudListener(candidateHash);\n","            triggerApprovedTransition(\"CREDENTIAL APPROVED\");\n","        } else {\n","            pinBuffer = \"\";\n","            renderPasscodeSlots();\n","            showToast(\"ACCESS DENIED: INVALID CREDENTIAL\", true);\n","        }\n","    }\n","\n","    function triggerApprovedTransition(statusLabel) {\n","        pinBuffer = \"\";\n","        renderPasscodeSlots();\n","\n","        const overlay = document.getElementById(\"credential-overlay\");\n","        const bar = document.getElementById(\"login-progress-bar\");\n","        document.getElementById(\"overlay-status-text\").textContent = statusLabel;\n","        document.getElementById(\"overlay-sub-text\").textContent = \"LOADING DATA...\";\n","\n","        bar.style.width = \"0%\";\n","        overlay.style.display = \"flex\";\n","\n","        requestAnimationFrame(() => {\n","            requestAnimationFrame(() => {\n","                bar.style.width = \"100%\";\n","            });\n","        });\n","\n","        setTimeout(() => {\n","            overlay.style.display = \"none\";\n","            document.getElementById(\"auth-screen\").classList.remove(\"active\");\n","            document.getElementById(\"main-screen\").classList.add(\"active\");\n","            switchTab(\"home\");\n","            renderDashboard();\n","        }, 780);\n","    }\n","\n","    function logoutTerminal() {\n","        document.getElementById(\"main-screen\").classList.remove(\"active\");\n","        document.getElementById(\"auth-screen\").classList.add(\"active\");\n","        configureAuthScreenMode();\n","    }\n","\n","    /* =========================================================\n","       RANK, JST CLOCK & ACTION PROTOCOLS\n","    ========================================================= */\n","    function getRankDetails(bp) {\n","        if (bp >= 10000) {\n","            return { code: \"S\", title: \"RANK S // SOVEREIGN\", rate: 3.0, colorClass: \"c-rank-s\", hex: \"#26c6da\", minBp: 10000, nextBp: null };\n","        }\n","        if (bp >= 6000) {\n","            return { code: \"A\", title: \"RANK A // EXECUTOR\", rate: 2.0, colorClass: \"c-rank-a\", hex: \"#ef5350\", minBp: 6000, nextBp: 10000 };\n","        }\n","        if (bp >= 3000) {\n","            return { code: \"B\", title: \"RANK B // OPERATIVE\", rate: 1.5, colorClass: \"c-rank-b\", hex: \"#ffa726\", minBp: 3000, nextBp: 6000 };\n","        }\n","        if (bp >= 1000) {\n","            return { code: \"C\", title: \"RANK C // AGENT\", rate: 1.2, colorClass: \"c-rank-c\", hex: \"#ffee58\", minBp: 1000, nextBp: 3000 };\n","        }\n","        return { code: \"D\", title: \"RANK D // INITIATE\", rate: 1.0, colorClass: \"c-rank-d\", hex: \"#4caf50\", minBp: 0, nextBp: 1000 };\n","    }\n","\n","    function getJstNow() {\n","        const now = new Date();\n","        const utcMs = now.getTime() + now.getTimezoneOffset() * 60000;\n","        return new Date(utcMs + 9 * 3600000);\n","    }\n","\n","    function getCurrentJstCycleId() {\n","        const jst = getJstNow();\n","        const shifted = new Date(jst.getTime() - 9 * 3600000);\n","        const y = shifted.getFullYear();\n","        const m = String(shifted.getMonth() + 1).padStart(2, \"0\");\n","        const d = String(shifted.getDate()).padStart(2, \"0\");\n","        return `${y}-${m}-${d}`;\n","    }\n","\n","    function updateJstClock() {\n","        const jst = getJstNow();\n","        const hh = String(jst.getHours()).padStart(2, \"0\");\n","        const mm = String(jst.getMinutes()).padStart(2, \"0\");\n","        const ss = String(jst.getSeconds()).padStart(2, \"0\");\n","        document.getElementById(\"jst-clock-display\").textContent = `JST ${hh}:${mm}:${ss}`;\n","\n","        const nextReset = new Date(jst);\n","        nextReset.setHours(9, 0, 0, 0);\n","        if (jst.getHours() >= 9) {\n","            nextReset.setDate(nextReset.getDate() + 1);\n","        }\n","        const diffSec = Math.max(0, Math.floor((nextReset - jst) / 1000));\n","        const rh = String(Math.floor(diffSec / 3600)).padStart(2, \"0\");\n","        const rm = String(Math.floor((diffSec % 3600) / 60)).padStart(2, \"0\");\n","        const rs = String(diffSec % 60).padStart(2, \"0\");\n","        document.getElementById(\"allowance-countdown\").textContent = `RESET IN ${rh}:${rm}:${rs}`;\n","    }\n","\n","    function claimDailyAllowance() {\n","        const cycleId = getCurrentJstCycleId();\n","        if (state.lastClaimCycleId === cycleId) {\n","            showToast(\"ALLOWANCE ALREADY DISTRIBUTED TODAY\", true);\n","            return;\n","        }\n","        const rank = getRankDetails(state.bp);\n","        const grant = Math.floor(100 * rank.rate);\n","        state.pp += grant;\n","        state.lastClaimCycleId = cycleId;\n","        saveTerminalState();\n","        showToast(`0900 JST ALLOWANCE CLAIMED: +${grant} PPt`);\n","    }\n","\n","    function executePositiveAction(id) {\n","        const item = state.positiveActions.find(a => a.id === id);\n","        if (!item) return;\n","\n","        const rank = getRankDetails(state.bp);\n","        const ppGain = Math.floor(item.pts * rank.rate);\n","        state.bp += item.pts;\n","        state.pp += ppGain;\n","        saveTerminalState();\n","        showToast(`EXECUTED: +${item.pts} BPt / +${ppGain} PPt`);\n","    }\n","\n","    function executeNegativeAction(id) {\n","        const item = state.negativeActions.find(a => a.id === id);\n","        if (!item) return;\n","\n","        state.bp = Math.max(0, state.bp - item.pts);\n","        state.pp = Math.max(0, state.pp - item.pts);\n","        saveTerminalState();\n","        showToast(`PENALTY APPLIED: -${item.pts} BPt / -${item.pts} PPt`, true);\n","    }\n","\n","    function executeRewardRedemption(id) {\n","        const item = state.rewards.find(r => r.id === id);\n","        if (!item) return;\n","\n","        if (state.pp < item.pts) {\n","            showToast(\"INSUFFICIENT PRIVATE POINTS\", true);\n","            return;\n","        }\n","        state.pp -= item.pts;\n","        saveTerminalState();\n","        showToast(`REWARD CLAIMED: -${item.pts} PPt`);\n","    }\n","\n","    async function updateSecurityCode() {\n","        const input = document.getElementById(\"admin-pin-input\");\n","        const newPin = input.value.trim();\n","        if (!/^\\d{12}$/.test(newPin)) {\n","            showToast(\"ERROR: PASSCODE MUST BE EXACTLY 12 DIGITS\", true);\n","            return;\n","        }\n","        const oldPinHash = state.pinHash;\n","        const newPinHash = await sha256Hex(newPin);\n","\n","        if (unsubscribeSnapshot) {\n","            unsubscribeSnapshot();\n","            unsubscribeSnapshot = null;\n","            activeSyncDocId = null;\n","        }\n","\n","        state.pinHash = newPinHash;\n","        input.value = \"\";\n","        saveTerminalState();\n","\n","        if (isCloudConnected && db && currentUser && oldPinHash && oldPinHash !== newPinHash) {\n","            try {\n","                await deleteDoc(getCloudDocRef(oldPinHash));\n","            } catch (err) {\n","                console.warn(\"Previous node cleanup skipped:\", err);\n","            }\n","        }\n","        showToast(\"12-DIGIT ACCESS PASSCODE UPDATED\");\n","    }\n","\n","    function saveAgentProfile() {\n","        const nameVal = document.getElementById(\"admin-name-input\").value.trim();\n","        const affilVal = document.getElementById(\"admin-affil-input\").value.trim();\n","        const idVal = document.getElementById(\"admin-id-input\").value.trim();\n","        if (nameVal) state.agentName = nameVal;\n","        if (affilVal) state.agentAffil = affilVal;\n","        if (idVal) state.agentId = idVal;\n","        saveTerminalState();\n","        showToast(\"OPERATIVE DOSSIER UPDATED\");\n","    }\n","\n","    function createProtocolItem(category) {\n","        let nameInput, ptsInput, collection;\n","        if (category === \"positive\") {\n","            nameInput = document.getElementById(\"new-pos-name\");\n","            ptsInput = document.getElementById(\"new-pos-pts\");\n","            collection = state.positiveActions;\n","        } else if (category === \"negative\") {\n","            nameInput = document.getElementById(\"new-neg-name\");\n","            ptsInput = document.getElementById(\"new-neg-pts\");\n","            collection = state.negativeActions;\n","        } else {\n","            nameInput = document.getElementById(\"new-rew-name\");\n","            ptsInput = document.getElementById(\"new-rew-pts\");\n","            collection = state.rewards;\n","        }\n","\n","        const title = nameInput.value.trim();\n","        const pts = parseInt(ptsInput.value, 10);\n","\n","        if (!title || isNaN(pts) || pts <= 0) {\n","            showToast(\"INVALID TITLE OR POINT VALUE\", true);\n","            return;\n","        }\n","\n","        collection.push({ id: Date.now(), name: title, pts });\n","        nameInput.value = \"\";\n","        ptsInput.value = \"\";\n","        saveTerminalState();\n","        showToast(\"PROTOCOL ENTRY REGISTERED\");\n","    }\n","\n","    function removeProtocolItem(category, id) {\n","        if (category === \"positive\") {\n","            state.positiveActions = state.positiveActions.filter(item => item.id !== id);\n","        } else if (category === \"negative\") {\n","            state.negativeActions = state.negativeActions.filter(item => item.id !== id);\n","        } else {\n","            state.rewards = state.rewards.filter(item => item.id !== id);\n","        }\n","        saveTerminalState();\n","        showToast(\"PROTOCOL ENTRY DELETED\");\n","    }\n","\n","    function openEditModal(category, id) {\n","        const collection = category === \"positive\"\n","            ? state.positiveActions\n","            : category === \"negative\"\n","                ? state.negativeActions\n","                : state.rewards;\n","\n","        const target = collection.find(item => item.id === id);\n","        if (!target) return;\n","\n","        editingTarget = { category, id };\n","        document.getElementById(\"modal-title-input\").value = target.name;\n","        document.getElementById(\"modal-pts-input\").value = target.pts;\n","        document.getElementById(\"modal-backdrop\").style.display = \"flex\";\n","    }\n","\n","    function closeModal() {\n","        editingTarget = null;\n","        document.getElementById(\"modal-backdrop\").style.display = \"none\";\n","    }\n","\n","    function confirmModalEdit() {\n","        if (!editingTarget) return;\n","        const newName = document.getElementById(\"modal-title-input\").value.trim();\n","        const newPts = parseInt(document.getElementById(\"modal-pts-input\").value, 10);\n","\n","        if (!newName || isNaN(newPts) || newPts <= 0) {\n","            showToast(\"INVALID INPUT VALUES\", true);\n","            return;\n","        }\n","\n","        const collection = editingTarget.category === \"positive\"\n","            ? state.positiveActions\n","            : editingTarget.category === \"negative\"\n","                ? state.negativeActions\n","                : state.rewards;\n","\n","        const target = collection.find(item => item.id === editingTarget.id);\n","        if (target) {\n","            target.name = newName;\n","            target.pts = newPts;\n","        }\n","\n","        closeModal();\n","        saveTerminalState();\n","        showToast(\"PROTOCOL ENTRY MODIFIED\");\n","    }\n","\n","    function exportNodeBackup() {\n","        try {\n","            const jsonStr = JSON.stringify(state);\n","            const encoded = btoa(unescape(encodeURIComponent(jsonStr)));\n","            const ioField = document.getElementById(\"backup-code-io\");\n","            ioField.value = encoded;\n","            ioField.select();\n","            document.execCommand(\"copy\");\n","            showToast(\"ENCRYPTED NODE KEY COPIED TO CLIPBOARD\");\n","        } catch (err) {\n","            showToast(\"EXPORT FAILED\", true);\n","        }\n","    }\n","\n","    function importNodeBackup() {\n","        const ioField = document.getElementById(\"backup-code-io\");\n","        const rawCode = ioField.value.trim();\n","        if (!rawCode) {\n","            showToast(\"PASTE BACKUP KEY FIRST\", true);\n","            return;\n","        }\n","        try {\n","            const decoded = decodeURIComponent(escape(atob(rawCode)));\n","            const imported = JSON.parse(decoded);\n","            if (!imported || typeof imported.bp !== \"number\" || typeof imported.pp !== \"number\") {\n","                throw new Error(\"Invalid node schema\");\n","            }\n","            state = { ...createDefaultState(), ...imported };\n","            ioField.value = \"\";\n","            saveTerminalState();\n","            showToast(\"NODE DATA RESTORED & SYNCHRONIZED\");\n","        } catch (err) {\n","            showToast(\"INVALID BACKUP DATA STRING\", true);\n","        }\n","    }\n","\n","    function openResetModal() {\n","        document.getElementById(\"reset-modal-backdrop\").style.display = \"flex\";\n","    }\n","\n","    function closeResetModal() {\n","        document.getElementById(\"reset-modal-backdrop\").style.display = \"none\";\n","    }\n","\n","    async function executeSystemPurge() {\n","        closeResetModal();\n","        const oldHash = state.pinHash;\n","\n","        if (unsubscribeSnapshot) {\n","            unsubscribeSnapshot();\n","            unsubscribeSnapshot = null;\n","            activeSyncDocId = null;\n","        }\n","\n","        if (isCloudConnected && db && currentUser && oldHash) {\n","            try {\n","                await deleteDoc(getCloudDocRef(oldHash));\n","            } catch (err) {\n","                console.warn(\"Cloud purge skipped:\", err);\n","            }\n","        }\n","\n","        try {\n","            localStorage.removeItem(STORAGE_KEY);\n","        } catch (err) {\n","            console.error(\"Storage purge warning:\", err);\n","        }\n","\n","        // In-memory state complete reset\n","        state = createDefaultState();\n","        pinBuffer = \"\";\n","        setupStep = 1;\n","        firstSetupPin = \"\";\n","        editingTarget = null;\n","\n","        // Clear Admin input fields\n","        document.getElementById(\"admin-pin-input\").value = \"\";\n","        document.getElementById(\"new-pos-name\").value = \"\";\n","        document.getElementById(\"new-pos-pts\").value = \"\";\n","        document.getElementById(\"new-neg-name\").value = \"\";\n","        document.getElementById(\"new-neg-pts\").value = \"\";\n","        document.getElementById(\"new-rew-name\").value = \"\";\n","        document.getElementById(\"new-rew-pts\").value = \"\";\n","        document.getElementById(\"backup-code-io\").value = \"\";\n","\n","        // Switch UI directly back to Initial 12-Digit Security Setup\n","        switchTab(\"home\");\n","        renderDashboard();\n","        configureAuthScreenMode();\n","\n","        document.getElementById(\"main-screen\").classList.remove(\"active\");\n","        document.getElementById(\"auth-screen\").classList.add(\"active\");\n","        showToast(\"SYSTEM PURGED // INITIALIZE NEW 12-DIGIT PASSCODE\", true);\n","    }\n","\n","    /* =========================================================\n","       NAVIGATION & UI RENDERING\n","    ========================================================= */\n","    function switchTab(tabKey) {\n","        document.querySelectorAll(\".tab-view\").forEach(view => {\n","            view.classList.remove(\"active\");\n","        });\n","        document.getElementById(`view-${tabKey}`).classList.add(\"active\");\n","\n","        document.querySelectorAll(\".nav-item\").forEach(nav => {\n","            nav.classList.toggle(\"active\", nav.dataset.target === tabKey);\n","        });\n","    }\n","\n","    function escapeHtml(text) {\n","        return text.replace(/[&<>\"']/g, ch => ({\n","            \"&\": \"&amp;\",\n","            \"<\": \"&lt;\",\n","            \">\": \"&gt;\",\n","            '\"': \"&quot;\",\n","            \"'\": \"&#39;\"\n","        })[ch]);\n","    }\n","\n","    function renderDashboard() {\n","        const rank = getRankDetails(state.bp);\n","\n","        // User Dossier & Admin Inputs\n","        document.getElementById(\"hud-agent-name\").textContent = state.agentName;\n","        document.getElementById(\"hud-agent-affil\").textContent = state.agentAffil;\n","        document.querySelector(\".agent-code-tag\").textContent = `ID: ${state.agentId || \"A01F-T006033\"}`;\n","        document.getElementById(\"admin-name-input\").value = state.agentName;\n","        document.getElementById(\"admin-affil-input\").value = state.agentAffil;\n","        document.getElementById(\"admin-id-input\").value = state.agentId || \"A01F-T006033\";\n","\n","        // HOME: PRIVATE POINT (Top Hero Card)\n","        document.getElementById(\"home-pp-val\").textContent = state.pp.toLocaleString();\n","\n","        // HOME: CURRENT RANK Card\n","        const rankFrame = document.getElementById(\"rank-panel-frame\");\n","        rankFrame.style.borderColor = rank.hex;\n","\n","        const emblem = document.getElementById(\"rank-emblem\");\n","        emblem.textContent = rank.code;\n","        emblem.className = `rank-emblem ${rank.colorClass}`;\n","\n","        const tierLabel = document.getElementById(\"rank-tier-label\");\n","        tierLabel.textContent = rank.title;\n","        tierLabel.className = `rank-tier-name ${rank.colorClass}`;\n","\n","        const rateVal = document.getElementById(\"rank-rate-val\");\n","        rateVal.textContent = `${rank.rate.toFixed(1)}x`;\n","        rateVal.className = `conversion-val mono ${rank.colorClass}`;\n","\n","        // Promotion Progress\n","        const promoLeftEl = document.getElementById(\"promo-left-val\");\n","        const promoFillEl = document.getElementById(\"promo-bar-fill\");\n","        promoFillEl.style.backgroundColor = rank.hex;\n","\n","        if (rank.nextBp === null) {\n","            promoLeftEl.textContent = \"MAX CLEARANCE REACHED\";\n","            promoFillEl.style.width = \"100%\";\n","        } else {\n","            const needed = rank.nextBp - state.bp;\n","            const span = rank.nextBp - rank.minBp;\n","            const pct = Math.min(100, Math.max(0, ((state.bp - rank.minBp) / span) * 100));\n","            promoLeftEl.textContent = `${needed.toLocaleString()} BPt`;\n","            promoFillEl.style.width = `${pct}%`;\n","        }\n","\n","        // HOME: BASIC POINT\n","        document.getElementById(\"home-bp-val\").textContent = state.bp.toLocaleString();\n","\n","        // HOME: 0900 JST PRIVATE POINT CLAIM\n","        const allowanceGrant = Math.floor(100 * rank.rate);\n","        document.getElementById(\"allowance-grant-val\").textContent = `+${allowanceGrant} PPt`;\n","\n","        const isClaimed = state.lastClaimCycleId === getCurrentJstCycleId();\n","        const claimBtn = document.getElementById(\"claim-allowance-btn\");\n","        const statusText = document.getElementById(\"allowance-status-text\");\n","\n","        claimBtn.disabled = isClaimed;\n","        if (isClaimed) {\n","            claimBtn.textContent = \"ALLOWANCE CLAIMED TODAY\";\n","            statusText.textContent = \"STATUS: DISTRIBUTED\";\n","            statusText.style.color = \"var(--text-muted)\";\n","        } else {\n","            claimBtn.textContent = \"EXECUTE ALLOWANCE CLAIM\";\n","            statusText.textContent = \"STATUS: READY FOR CLAIM\";\n","            statusText.style.color = rank.hex;\n","        }\n","\n","        // POSITIVE ACTIONS LIST\n","        document.getElementById(\"pos-multiplier-info\").textContent = `RATE: ${rank.rate.toFixed(1)}x`;\n","        document.getElementById(\"positive-list-container\").innerHTML = state.positiveActions.map(item => {\n","            const ppGain = Math.floor(item.pts * rank.rate);\n","            return `\n","                <div class=\"action-card\">\n","                    <div class=\"action-info\">\n","                        <div class=\"action-name\">${escapeHtml(item.name)}</div>\n","                        <div class=\"action-tags mono\">\n","                            <span class=\"tag-pill\">+${item.pts} BPt</span>\n","                            <span class=\"tag-pill tag-pos\">+${ppGain} PPt</span>\n","                        </div>\n","                    </div>\n","                    <button class=\"trigger-btn\" onclick=\"executePositiveAction(${item.id})\">EXECUTE</button>\n","                </div>\n","            `;\n","        }).join(\"\");\n","\n","        // NEGATIVE ACTIONS LIST\n","        document.getElementById(\"negative-list-container\").innerHTML = state.negativeActions.map(item => {\n","            return `\n","                <div class=\"action-card\">\n","                    <div class=\"action-info\">\n","                        <div class=\"action-name\">${escapeHtml(item.name)}</div>\n","                        <div class=\"action-tags mono\">\n","                            <span class=\"tag-pill\">-${item.pts} BPt</span>\n","                            <span class=\"tag-pill tag-neg\">-${item.pts} PPt</span>\n","                        </div>\n","                    </div>\n","                    <button class=\"trigger-btn neg-btn\" onclick=\"executeNegativeAction(${item.id})\">APPLY</button>\n","                </div>\n","            `;\n","        }).join(\"\");\n","\n","        // REWARDS SELECTION LIST\n","        document.getElementById(\"reward-balance-info\").textContent = `BALANCE: ${state.pp.toLocaleString()} PPt`;\n","        document.getElementById(\"reward-list-container\").innerHTML = state.rewards.map(item => {\n","            const canAfford = state.pp >= item.pts;\n","            return `\n","                <div class=\"action-card\" style=\"opacity:${canAfford ? \"1\" : \"0.55\"};\">\n","                    <div class=\"action-info\">\n","                        <div class=\"action-name\">${escapeHtml(item.name)}</div>\n","                        <div class=\"action-tags mono\">\n","                            <span class=\"tag-pill tag-cost\">${item.pts.toLocaleString()} PPt</span>\n","                        </div>\n","                    </div>\n","                    <button class=\"trigger-btn\" ${canAfford ? \"\" : \"disabled\"} onclick=\"executeRewardRedemption(${item.id})\">CLAIM</button>\n","                </div>\n","            `;\n","        }).join(\"\");\n","\n","        // ADMIN REGISTRY LISTS\n","        renderAdminRegistry(\"positive\", state.positiveActions, \"admin-positive-list\", \"BPt\");\n","        renderAdminRegistry(\"negative\", state.negativeActions, \"admin-negative-list\", \"BPt\");\n","        renderAdminRegistry(\"reward\", state.rewards, \"admin-reward-list\", \"PPt\");\n","    }\n","\n","    function renderAdminRegistry(category, list, targetId, unit) {\n","        const el = document.getElementById(targetId);\n","        if (!list.length) {\n","            el.innerHTML = `<div style=\"font-size:0.68rem; color:var(--text-muted); padding:4px 0;\">NO REGISTERED ENTRIES</div>`;\n","            return;\n","        }\n","        el.innerHTML = list.map(item => `\n","            <div class=\"admin-item-row\">\n","                <span style=\"overflow:hidden; text-overflow:ellipsis; white-space:nowrap;\">\n","                    ${escapeHtml(item.name)} <span class=\"mono\" style=\"color:var(--text-secondary);\">[${item.pts} ${unit}]</span>\n","                </span>\n","                <div class=\"admin-row-actions\">\n","                    <button class=\"sm-op-btn\" onclick=\"openEditModal('${category}', ${item.id})\">EDIT</button>\n","                    <button class=\"sm-op-btn del\" onclick=\"removeProtocolItem('${category}', ${item.id})\">DEL</button>\n","                </div>\n","            </div>\n","        `).join(\"\");\n","    }\n","\n","    // Expose functions to global window scope for inline HTML event handlers\n","    Object.assign(window, {\n","        inputDigit,\n","        clearInput,\n","        backspaceInput,\n","        handleAuthSubmit,\n","        logoutTerminal,\n","        switchTab,\n","        claimDailyAllowance,\n","        executePositiveAction,\n","        executeNegativeAction,\n","        executeRewardRedemption,\n","        updateSecurityCode,\n","        saveAgentProfile,\n","        createProtocolItem,\n","        removeProtocolItem,\n","        openEditModal,\n","        closeModal,\n","        confirmModalEdit,\n","        exportNodeBackup,\n","        importNodeBackup,\n","        openResetModal,\n","        closeResetModal,\n","        executeSystemPurge\n","    });\n","\n","    // Boot Terminal\n","    window.addEventListener(\"DOMContentLoaded\", async () => {\n","        loadTerminalState();\n","        configureAuthScreenMode();\n","        renderDashboard();\n","        updateJstClock();\n","        setInterval(updateJstClock, 1000);\n","        await initCloudEngine();\n","    });\n","</script>\n","</body>\n","</html>"],"metadata":{"id":"aeNOeo0UpJT1"},"execution_count":null,"outputs":[]}]}